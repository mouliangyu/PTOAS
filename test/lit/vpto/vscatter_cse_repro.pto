// RUN: ( mkdir -p %T && ptoas --pto-arch=a5 --pto-backend=vpto %s -o %t --emit-vpto-llvm-ir 2>&1 || true ) | FileCheck %s

// Issue: bisheng CSE eliminates vlds after vscatter+mem_bar
//
// When a vscatter writes to UB and a subsequent vlds reads from the same UB
// address, bisheng's CSE pass eliminates the second vlds — even when a
// mem_bar("VST_VLD") is placed between the vscatter and vlds.
//
// The ptoas LLVM IR correctly preserves both vlds calls and the mem_bar
// (verified by the CHECK lines below). However, bisheng's optimizer
// downstream CSE's the second load into the first, producing incorrect code.
//
// Impact: vscatter cannot be used for in-place masking of UB data that is
// later reloaded via vlds. Workaround: use vsts instead of vscatter (vsts
// IS recognized as a store by bisheng's CSE pass).

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vscatter_cse_repro(%arg0: !pto.ptr<f32, gm>, %arg1: !pto.ptr<i32, gm>, %arg2: !pto.ptr<f32, gm>) attributes {pto.kernel} {
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c256_i64 = arith.constant 256 : i64
    %c512_i64 = arith.constant 512 : i64
    %c0 = arith.constant 0 : index
    %c0_f32 = arith.constant 0.0 : f32

    %ub_data = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub_idx  = pto.castptr %c256_i64 : i64 -> !pto.ptr<i32, ub>
    %ub_out  = pto.castptr %c512_i64 : i64 -> !pto.ptr<f32, ub>

    pto.mte_gm_ub %arg0, %ub_data, %c0_i64, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64
    pto.mte_gm_ub %arg1, %ub_idx, %c0_i64, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<i32, gm>, !pto.ptr<i32, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]

    pto.vecscope {
      %full_mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>

      // Load #1: read original data from UB[0..63]
      %load1 = pto.vlds %ub_data[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>

      // Scatter 0.0 to UB at positions given by indices (modifies UB[0..63])
      %offsets = pto.vlds %ub_idx[%c0] : !pto.ptr<i32, ub> -> !pto.vreg<64xi32>
      %zero_f32 = pto.vbr %c0_f32 : f32 -> !pto.vreg<64xf32>
      pto.vscatter %zero_f32, %ub_data, %offsets, %full_mask
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vreg<64xi32>, !pto.mask<b32>

      // mem_bar should enforce store-to-load ordering
      pto.mem_bar "VST_VLD"

      // Load #2: read data from UB[0..63] again — should see scattered 0.0
      // BUG: bisheng CSE's this load into load1, ignoring the vscatter write
      %load2 = pto.vlds %ub_data[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>

      // Store both loads to different UB regions (forces both to be live)
      pto.vsts %load1, %ub_out[%c0], %full_mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.vsts %load2, %ub_data[%c0], %full_mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }

    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_out, %arg2, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<f32, ub>, !pto.ptr<f32, gm>, i64, i64, i64, i64

    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}

// Verify ptoas LLVM IR preserves both loads and the mem_bar.
// If this CHECK passes, the bug is in bisheng (downstream of ptoas).
//
// CHECK-LABEL: define void @vscatter_cse_repro_mix_aiv
// CHECK: call <64 x float> @llvm.hivm.vldsx1.v64f32
// CHECK: call void @llvm.hivm.vscatter.v64f32.v300
// CHECK: call void @llvm.hivm.mem.bar.vst.vld()
// CHECK: call <64 x float> @llvm.hivm.vldsx1.v64f32
// CHECK: call void @llvm.hivm.vstsx1.v64f32
// CHECK: call void @llvm.hivm.vstsx1.v64f32
